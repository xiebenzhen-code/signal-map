# Server-only X official API credential. Never expose it through a VITE_ variable.
X_BEARER_TOKEN=

# Xiaohongshu connection adapter: local (local QR session) or oauth.
XHS_CONNECTION_ADAPTER=local

# Local mode. The service must bind to a loopback address.
XHS_SERVICE_URL=http://127.0.0.1:18080

# OAuth mode. Keep all values server-side and leave them empty in source control.
XHS_CLIENT_ID=
XHS_CLIENT_SECRET=
XHS_ACCESS_TOKEN=
XHS_OAUTH_API_BASE_URL=

# Presentation translation. Only already-discovered public source text is sent.
# User Filter fields and credentials are never sent to this service.
TRANSLATION_ENABLED=true
TRANSLATION_TARGET_LANGUAGE=zh-CN
TRANSLATION_SERVICE_URL=https://translate.googleapis.com/translate_a/single
TRANSLATION_FALLBACK_SERVICE_URL=https://api.mymemory.translated.net/get

# Server-only PostgreSQL connection. Never expose through VITE_ variables.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# TEMPORARY incident diagnostic for /api/diagnostics/supabase-auth-transport.
# Leave empty in production: the endpoint returns 404 until this is set, and it
# is sent as the x-signal-map-diagnostic-token header. Remove after the incident.
SIGNAL_MAP_DIAGNOSTIC_TOKEN=

# SSR server only: pure http(s) origin, no credentials/path/query/hash.
# Required in production; when absent, development defaults to loopback.
# An explicitly empty value fails closed in every environment.
# API_UPSTREAM_URL=https://your-node-api.example
# SIGNAL_MAP_ALLOWED_ORIGIN must be a canonical public HTTPS origin in production.
# Also controls password recovery redirect; do not include a trailing slash/path.
# SIGNAL_MAP_ALLOWED_ORIGIN=https://signal.benzhenlab.com
# Legacy placeholder below is not used by the password-reset handler.
SUPABASE_AUTH_REDIRECT_URL=
PUBLIC_GUEST_ENABLED=false
PGSSLMODE=
POSTGRES_SSL=
POSTGRES_POOL_MAX=5
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=5000

# Server-only model credentials. Never expose through VITE_ variables.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_SYNTHESIS_MODEL=gpt-6-astra
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_SYNTHESIS_MODEL=deepseek-reasoner
