# Server-only X official API credential. Never expose it through a VITE_ variable.
X_BEARER_TOKEN=

# Xiaohongshu connection adapter: local (local QR session) or oauth.
XHS_CONNECTION_ADAPTER=local

# Local mode. The service must bind to a loopback address.
XHS_SERVICE_URL=http://127.0.0.1:18080

# OAuth mode. Keep all values server-side and leave them empty in source control.
XHS_CLIENT_ID=
XHS_CLIENT_SECRET=
XHS_ACCESS_TOKEN=
XHS_OAUTH_API_BASE_URL=

# Presentation translation. Only already-discovered public source text is sent.
# User Filter fields and credentials are never sent to this service.
TRANSLATION_ENABLED=true
TRANSLATION_TARGET_LANGUAGE=zh-CN
TRANSLATION_SERVICE_URL=https://translate.googleapis.com/translate_a/single
TRANSLATION_FALLBACK_SERVICE_URL=https://api.mymemory.translated.net/get
