FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN --network=none npm run build:node

# Frontend SSR only. The existing Dockerfile remains the standalone API image.
FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
# vinext and the RSC implementation are runtime requirements despite npm's
# devDependency classification. Do not omit them or install new versions.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/scripts/frontend-node.mjs ./scripts/frontend-node.mjs
COPY --from=build /app/source-registry/sources.json ./source-registry/sources.json
COPY --from=build /app/certs ./certs
ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0
EXPOSE 3000
CMD ["node", "scripts/frontend-node.mjs", "start"]
